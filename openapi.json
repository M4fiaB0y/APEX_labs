{
  "openapi": "3.0.3",
  "info": {
    "title": "ApexMart E-Commerce & Cryptographic Hardware API Gateway",
    "description": "Production-grade Banking, Payment, and Cloud microservices gateway API specification. Intended for internal engineering teams and authorized partner integrations.",
    "version": "2026.4.1",
    "contact": {
      "name": "Apex Security Operations",
      "email": "security@apexmart.local"
    }
  },
  "servers": [
    {
      "url": "http://127.0.0.1:5000",
      "description": "Local Development & Pen-testing Gateway"
    }
  ],
  "paths": {
    "/api/v1/users/{uid}": {
      "get": {
        "summary": "Retrieve User Profile",
        "parameters": [
          { "name": "uid", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": { "200": { "description": "User profile with PII" } }
      }
    },
    "/api/v1/accounts/{account_num}/statement": {
      "get": {
        "summary": "Fetch Account Statement",
        "parameters": [
          { "name": "account_num", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Bank account balance and statement" } }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "summary": "Authenticate User",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": { "type": "string" },
                  "password": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "JWT Auth Token" } }
      }
    },
    "/api/v1/auth/verify-jwt": {
      "post": {
        "summary": "Verify JWT Session",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": { "token": { "type": "string" } }
              }
            }
          }
        },
        "responses": { "200": { "description": "Verified claims" } }
      }
    },
    "/api/v1/users/register": {
      "post": {
        "summary": "Register Customer Profile",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": { "type": "string" },
                  "password": { "type": "string" },
                  "role": { "type": "string" },
                  "wallet_balance": { "type": "number" },
                  "balance": { "type": "number" }
                }
              }
            }
          }
        },
        "responses": { "201": { "description": "Created user" } }
      }
    },
    "/api/v1/graphql": {
      "post": {
        "summary": "GraphQL Operations Gateway",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": { "query": { "type": "string" } }
              }
            }
          }
        },
        "responses": { "200": { "description": "GraphQL result" } }
      }
    },
    "/api/v1/admin/export-database": {
      "post": {
        "summary": "Export Enterprise Database",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "format": { "type": "string", "example": "json" },
                  "include_tables": { "type": "array", "items": { "type": "string" } }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Full database dump" } }
      }
    },
    "/api/v1/store/checkout": {
      "post": {
        "summary": "Process Order Checkout",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "items": { "type": "array" },
                  "total": { "type": "number" },
                  "user_id": { "type": "integer" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Checkout result" } }
      }
    },
    "/api/v1/vouchers/redeem": {
      "post": {
        "summary": "Redeem Promotional Voucher",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "code": { "type": "string" },
                  "user_id": { "type": "integer" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Voucher credited" } }
      }
    },
    "/api/v1/integrations/fetch-webhook": {
      "get": {
        "summary": "Integration Webhook Dispatcher",
        "parameters": [
          { "name": "url", "in": "query", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Fetched resource" } }
      }
    },
    "/api/v1/transactions/search": {
      "get": {
        "summary": "Search Catalog & Audit Records",
        "parameters": [
          { "name": "q", "in": "query", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Matching transactions" } }
      }
    },
    "/api/v1/invoice/xml": {
      "post": {
        "summary": "Import XML Billing Invoice",
        "requestBody": {
          "required": true,
          "content": {
            "application/xml": {
              "schema": { "type": "string" }
            }
          }
        },
        "responses": { "200": { "description": "Parsed invoice" } }
      }
    }
  }
}
